# ZEROLOCK Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave blank to automatically initialize embedded MongoMemoryServer for development,
# or specify your local / MongoDB Atlas connection string:
# MONGODB_URI=mongodb://localhost:27017/zerolock
MONGODB_URI=

# JWT & Cookie Signing Secrets (Minimum 32 characters in production)
JWT_SECRET=zerolock_production_grade_jwt_signing_secret_key_32bytes
JWT_EXPIRES_IN=7d
COOKIE_SECRET=zerolock_production_grade_cookie_signing_secret_key_32bytes

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# File Uploads Directory
UPLOAD_DIR=uploads
